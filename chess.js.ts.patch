+  146: 'N', // Novelty
+  32: '↑↑', // Development
+  36: '↑', // Initiative
+  40: '→', // Attack
+  132: '⇆', // Counterplay
+  138: '⊕', // Time trouble
+  44: '=∞', // With compensation
+  140: '∆', // With the idea
