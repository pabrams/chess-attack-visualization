+export const NAG_TO_SYMBOL = {
+  7: '□', // Only move
+  22: '⨀', // Zugzwang
+  10: '=', // Equal position
+  13: '∞', // Unclear position
+  14: '⩲', // White is slightly better
+  15: '⩱', // Black is slightly better
+  16: '±', // White is better
